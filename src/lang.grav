// lang.grav — translations for Apogee apps: messages kept per language in
// JSON files, picked by key, with placeholders and plurals.
//
//   lang/en/auth.json    {"failed": "These credentials do not match.", "welcome": "Welcome, :name!"}
//   lang/es/auth.json    {"failed": "Estas credenciales no coinciden.", "welcome": "¡Bienvenido, :name!"}
//   lang/en/cart.json    {"items": "{0} Your cart is empty|{1} One item|[2,*] :count items"}
//   lang/es.json         {"Save changes": "Guardar cambios"}           (whole sentences as keys)
//
//   let t = new Translator("lang", "en", "en")   // directory, locale, fallback
//   t.get("auth.welcome", {"name": "Ada"})       // "Welcome, Ada!"
//   t.choice("cart.items", 3)                    // "3 items"
//   t.get("Save changes", null, "es")            // "Guardar cambios"
//   Lang.use(t); trans("auth.failed")             // the app's translator
//
// A key is "group.key" ("auth.failed" is "failed" in lang/<locale>/auth.json;
// deeper keys are nested objects: "validation.custom.email.required"). A key
// with no group file is looked up in lang/<locale>.json. A missing key falls
// back to the fallback locale, and then to the key itself.
import "std"

namespace apogee {

    // A language's plural forms: which form (0, 1, 2, ...) a count takes, after
    // the rules CLDR gives (and Laravel's MessageSelector follows).
    class PluralRules {
        static fn index(locale: string, n0: long) -> int {
            let n = n0 < 0 ? -n0 : n0;
            let lang = Str.lower(locale);
            let cut = Str.indexOf(lang, "_");
            if (cut < 0) { cut = Str.indexOf(lang, "-"); }
            if (cut > 0) { lang = lang[..cut]; }
            switch (lang) {
                // one form
                case "az", "bo", "dz", "id", "ja", "jv", "ka", "km", "kn", "ko", "ms", "th", "tr", "vi", "zh":
                    return 0
                // n is 0 or 1: the first form
                case "am", "bh", "fil", "fr", "gun", "hi", "hy", "ln", "mg", "nso", "pt_br", "ti", "wa":
                    return n == 0 || n == 1 ? 0 : 1
                // Russian, Ukrainian, Belarusian, Serbian, Croatian, Bosnian
                case "be", "bs", "hr", "ru", "sh", "sr", "uk": {
                    if (n % 10 == 1 && n % 100 != 11) { return 0; }
                    if (n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 10 || n % 100 >= 20)) { return 1; }
                    return 2;
                }
                case "cs", "sk": return n == 1 ? 0 : (n >= 2 && n <= 4 ? 1 : 2)
                case "ga": return n == 1 ? 0 : (n == 2 ? 1 : 2)
                case "lt": {
                    if (n % 10 == 1 && n % 100 != 11) { return 0; }
                    if (n % 10 >= 2 && (n % 100 < 10 || n % 100 >= 20)) { return 1; }
                    return 2;
                }
                case "sl": return n % 100 == 1 ? 0 : (n % 100 == 2 ? 1 : (n % 100 == 3 || n % 100 == 4 ? 2 : 3))
                case "mk": return n % 10 == 1 ? 0 : 1
                case "mt": {
                    if (n == 1) { return 0; }
                    if (n == 0 || (n % 100 > 1 && n % 100 < 11)) { return 1; }
                    if (n % 100 > 10 && n % 100 < 20) { return 2; }
                    return 3;
                }
                case "lv": return n == 0 ? 0 : (n % 10 == 1 && n % 100 != 11 ? 1 : 2)
                case "pl": {
                    if (n == 1) { return 0; }
                    if (n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14)) { return 1; }
                    return 2;
                }
                case "cy": return n == 1 ? 0 : (n == 2 ? 1 : (n == 8 || n == 11 ? 2 : 3))
                case "ro": return n == 1 ? 0 : (n == 0 || (n % 100 > 0 && n % 100 < 20) ? 1 : 2)
                case "ar": {
                    if (n == 0) { return 0; }
                    if (n == 1) { return 1; }
                    if (n == 2) { return 2; }
                    if (n % 100 >= 3 && n % 100 <= 10) { return 3; }
                    if (n % 100 >= 11 && n % 100 <= 99) { return 4; }
                    return 5;
                }
                // English and most others: one, then many
                default: return n == 1 ? 0 : 1
            }
        }
    }

    // One variant of a "one|many" message: its text, and the counts it says it
    // is for (`{1,2}`: exactly those; `[2,*]`: a range; neither: any).
    class PluralVariant {
        public text: string
        public exact: Array<long> = null
        public ranged: bool = false
        public lo: long = 0
        public hi: long = 0
        public loOpen: bool = false
        public hiOpen: bool = false
        constructor(text: string) { self.text = text; }
        fn takes(count: long) -> bool {
            if (self.exact != null) { return self.exact.contains(count); }
            if (self.ranged) { return (self.loOpen || count >= self.lo) && (self.hiOpen || count <= self.hi); }
            return false;
        }
    }

    // Picks the variant of a "one|many" message for a count: explicit
    // `{n}` / `[a,b]` / `[a,*]` ranges first, else the language's plural form.
    class MessageSelector {
        static fn choose(line: string, count: long, locale: string) -> string {
            return MessageSelector.pick(MessageSelector.parse(line), count, locale);
        }
        // From variants already parsed (a Translator keeps them per message).
        static fn pick(variants: Array<PluralVariant>, count: long, locale: string) -> string {
            for (v in variants) { if (v.takes(count)) { return v.text; } }
            let i = PluralRules.index(locale, count);
            return variants[i < variants.size() ? i : variants.size() - 1].text;   // (fewer variants than forms: the last)
        }
        // The variants of a message, with what each says about counts.
        static fn parse(line: string) -> Array<PluralVariant> {
            let out = new Array<PluralVariant>();
            for (part in MessageSelector.split(line)) {
                let open = part.length > 0 ? part[0] as int : 0;
                let close = open == 123 ? Str.indexOf(part, "}") : (open == 91 ? Str.indexOf(part, "]") : -1);
                if (close < 0) { out.push(new PluralVariant(part)); continue; }
                let v = new PluralVariant(Str.trim(part[close + 1..]));
                let spec = Str.trim(part[1..close]);
                if (open == 123) {
                    v.exact = new Array<long>();
                    for (x in Str.split(spec, ",")) { if (Str.trim(x) != "") { v.exact.push(Integer.parseOr(Str.trim(x), -1)); } }
                } else {
                    let comma = Str.indexOf(spec, ",");
                    if (comma >= 0) {
                        let lo = Str.trim(spec[..comma]);
                        let hi = Str.trim(spec[comma + 1..]);
                        v.ranged = true;
                        v.loOpen = lo == "*";
                        v.hiOpen = hi == "*";
                        v.lo = Integer.parseOr(lo, 0);
                        v.hi = Integer.parseOr(hi, 0);
                    }
                }
                out.push(v);
            }
            return out;
        }
        // The variants, split on "|" (a "|" inside {...} or [...] does not split).
        private static fn split(line: string) -> Array<string> {
            let out = new Array<string>();
            let depth = 0;
            let start = 0;
            for (i in 0..line.length) {
                let c = line[i] as int;
                if (c == 123 || c == 91) { depth += 1; }
                else if ((c == 125 || c == 93) && depth > 0) { depth -= 1; }
                else if (c == 124 && depth == 0) { out.push(Str.trim(line[start..i])); start = i + 1; }
            }
            out.push(Str.trim(line[start..]));
            return out;
        }
    }

    // Messages by locale, read from JSON files once and then kept.
    class Translator {
        // lang/ (the directory holding <locale>/ folders and <locale>.json files).
        public directory: string
        public locale: string
        public fallback: string
        // locale -> group -> flattened key ("custom.email.required") -> message
        private loaded: HashMap<string, HashMap<string, HashMap<string, string>>>
        private lock: Mutex
        // plural messages, parsed the first time they are used
        private plurals: HashMap<string, Array<PluralVariant>>

        constructor(directory: string, locale: string = "en", fallback: string = "en") {
            self.directory = Str.endsWith(directory, "/") ? directory[..directory.length - 1] : directory;
            self.locale = locale;
            self.fallback = fallback;
            self.loaded = new HashMap<string, HashMap<string, HashMap<string, string>>>();
            self.lock = new Mutex();
            self.plurals = new HashMap<string, Array<PluralVariant>>();
        }

        // The message for `key` (see the top of the file), placeholders filled in
        // from `replace`; the key itself when no locale has it.
        fn get(key: string, replace: HashMap<string, any> = null, locale: string = "") -> string {
            let line = self.lineOr(key, locale == "" ? self.locale : locale);
            return Translator.fill(line ?? key, replace);
        }
        // The variant of a plural message for `count` (":count" is filled in too).
        fn choice(key: string, count: long, replace: HashMap<string, any> = null, locale: string = "") -> string {
            let loc = locale == "" ? self.locale : locale;
            let line = self.lineOr(key, loc) ?? key;
            self.lock.lock();
            let variants = self.plurals.getOr(line, null);
            if (variants == null) {
                variants = MessageSelector.parse(line);
                if (self.plurals.size() < 10000) { self.plurals.put(line, variants); }
            }
            self.lock.unlock();
            return Translator.fillCount(MessageSelector.pick(variants, count, loc), replace, str(count));
        }
        // Whether `key` has a message in `locale` (or the current one), not counting the fallback.
        fn has(key: string, locale: string = "") -> bool {
            return self.find(key, locale == "" ? self.locale : locale) != null;
        }
        // Adds (or replaces) messages: `lines` keyed like files are ("failed",
        // "custom.email.required"), in `group` ("" for sentence keys).
        fn addLines(locale: string, group: string, lines: HashMap<string, string>) {
            self.lock.lock();
            try {
                let g = self.groupLocked(locale, group);
                for ((k, v) in lines) { g.put(k, v); }
            } finally { self.lock.unlock(); }
        }
        // The locales with a folder or a file in the directory.
        fn locales() -> Array<string> {
            let seen = new HashSet<string>();
            for (name in Dir.list(self.directory)) {
                if (Dir.exists(self.directory + "/" + name)) { seen.add(name); }
                else if (Str.endsWith(name, ".json")) { seen.add(name[..name.length - 5]); }
            }
            let out = seen.toArray();
            out.sortBy(fn(a, b) => Str.compare(a, b));
            return out;
        }

        // ── lookup ─────────────────────────────────────────────────────────────
        private fn lineOr(key: string, locale: string) -> string? {
            let line = self.find(key, locale);
            if (line == null && self.fallback != "" && self.fallback != locale) { line = self.find(key, self.fallback); }
            return line;
        }
        // (one lock for the whole lookup)
        private fn find(key: string, locale: string) -> string? {
            let dot = Str.indexOf(key, ".");
            let grouped = dot > 0 && !Str.contains(key, " ");
            self.lock.lock();
            try {
                if (grouped) {
                    let g = self.groupLocked(locale, key[..dot]);
                    let k = key[dot + 1..];
                    if (g.containsKey(k)) { return g.get(k); }
                }
                let sentences = self.groupLocked(locale, "");
                return sentences.containsKey(key) ? sentences.get(key) : null;
            } finally { self.lock.unlock(); }
        }
        // A group's messages, read from its file the first time ("" : <locale>.json);
        // the lock is held by the caller.
        private fn groupLocked(locale: string, name: string) -> HashMap<string, string> {
            let byGroup = self.loaded.getOr(locale, null);
            if (byGroup == null) { byGroup = new HashMap<string, HashMap<string, string>>(); self.loaded.put(locale, byGroup); }
            let g = byGroup.getOr(name, null);
            if (g == null) {
                g = new HashMap<string, string>();
                let file = name == "" ? self.directory + "/" + locale + ".json" : self.directory + "/" + locale + "/" + name + ".json";
                let text = new File(file).readOr("");
                if (text != "") {
                    let j: JsonValue = null;
                    try { j = Json.parse(text); }
                    catch (e: ValueError) { throw new ValueError("${file}: " + e.message()); }
                    Translator.flatten(j, "", g);
                }
                byGroup.put(name, g);
            }
            return g;
        }
        private static fn flatten(j: JsonValue, prefix: string, out: HashMap<string, string>) {
            if (!j.isObject()) { return; }
            for ((k, v) in j.entries()) {
                let full = prefix == "" ? k : prefix + "." + k;
                if (v.isObject()) { Translator.flatten(v, full, out); }
                else if (v.isString()) { out.put(full, v.asString()); }
                else { out.put(full, v.toJson()); }
            }
        }

        // `:name` replaced by the value, `:Name` by it capitalized, `:NAME` by it
        // upper-cased; the longest name that matches wins (":names" with only
        // "name" given is the value and an "s"). One pass over the line.
        static fn fill(line: string, replace: HashMap<string, any>) -> string { return Translator.fillCount(line, replace, ""); }
        // fill(), with `count` (when not "") standing for a :count `replace` lacks.
        static fn fillCount(line: string, replace: HashMap<string, any>, count: string) -> string {
            let none = replace == null || replace.size() == 0;
            if ((none && count == "") || Str.indexOf(line, ":") < 0) { return line; }
            let sb = new StringBuilder();
            sb.reserve(line.length + 32);
            let n = line.length;
            let last = 0;
            let i = 0;
            while (i < n) {
                if (line[i] != (58 as byte)) { i += 1; continue; }           // ':'
                let j = i + 1;
                while (j < n && Translator.namePart(line[j] as int)) { j += 1; }
                let end = j;
                let hit = false;
                while (end > i + 1) {
                    let v = Translator.valueFor(line[i + 1..end], replace, count);
                    if (v != null) {
                        sb.append(line[last..i]).append(v);
                        last = end;
                        i = end;
                        hit = true;
                        break;
                    }
                    end -= 1;
                }
                if (!hit) { i += 1; }
            }
            if (last == 0) { return line; }
            sb.append(line[last..]);
            return sb.toString();
        }
        private static fn namePart(c: int) -> bool { return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95; }
        // What `:name` becomes: the value of "name", or of its lower-case or
        // first-lowered form (then upper-cased or capitalized); null for none.
        private static fn valueFor(name: string, replace: HashMap<string, any>, count: string) -> string? {
            if (replace != null && replace.containsKey(name)) { return str(replace.get(name)); }
            if (name == "count" && count != "") { return count; }
            let lower = Str.lower(name);
            if (lower != name) {
                if (name == Str.upper(name)) {
                    if (replace != null && replace.containsKey(lower)) { return Str.upper(str(replace.get(lower))); }
                    if (lower == "count" && count != "") { return count; }
                }
                let first = Str.lower(name[..1]) + name[1..];
                if (replace != null && replace.containsKey(first)) { return Translator.capital(str(replace.get(first))); }
            }
            return null;
        }
        private static fn capital(s: string) -> string { return s == "" ? s : Str.upper(s[..1]) + s[1..]; }
    }

    // Choosing a locale for a request.
    class Locale {
        // The best of `available` for an Accept-Language header ("es-MX,es;q=0.9,en;q=0.5"),
        // matching a language without its region too ("es-MX" takes "es"); `fallback`
        // when none fits.
        static fn negotiate(acceptLanguage: string, available: Array<string>, fallback: string) -> string {
            let best = fallback;
            let bestQ = -1.0;
            let order = 0;
            for (item in Str.split(acceptLanguage, ",")) {
                order += 1;
                let parts = Str.split(Str.trim(item), ";");
                let tag = Str.lower(Str.replace(Str.trim(parts[0]), "_", "-"));
                if (tag == "") { continue; }
                let q = 1.0;
                for (i in 1..parts.size()) {
                    let p = Str.trim(parts[i]);
                    if (Str.startsWith(p, "q=")) { q = Float.parseOr(p[2..], 0.0); }
                }
                let hit = Locale.match(tag, available);
                // ties keep the header's order (an earlier entry wins)
                if (hit != "" && q > bestQ) { best = hit; bestQ = q; }
            }
            return best;
        }
        private static fn match(tag: string, available: Array<string>) -> string {
            for (a in available) { if (Str.lower(Str.replace(a, "_", "-")) == tag) { return a; } }
            let dash = Str.indexOf(tag, "-");
            let lang = dash > 0 ? tag[..dash] : tag;
            for (a in available) { if (Str.lower(a) == lang) { return a; } }
            for (a in available) {
                let al = Str.lower(Str.replace(a, "_", "-"));
                if (Str.startsWith(al, lang + "-")) { return a; }
            }
            return "";
        }
    }

    // The app's translator, as statics.
    class Lang {
        private static translator: Translator = null
        static fn use(t: Translator) { Lang.translator = t; }
        static fn instance() -> Translator {
            let t = Lang.translator;
            if (t == null) { throw new StateError("no translator: call Lang.use(new Translator(\"lang\", ...)) first"); }
            return t;
        }
        static fn setLocale(locale: string) { Lang.instance().locale = locale; }
        static fn locale() -> string { return Lang.instance().locale; }
        static fn get(key: string, replace: HashMap<string, any> = null, locale: string = "") -> string {
            return Lang.instance().get(key, replace, locale);
        }
        static fn choice(key: string, count: long, replace: HashMap<string, any> = null, locale: string = "") -> string {
            return Lang.instance().choice(key, count, replace, locale);
        }
        static fn has(key: string) -> bool { return Lang.instance().has(key); }
    }

    // Lang.get and Lang.choice, short.
    fn trans(key: string, replace: HashMap<string, any> = null, locale: string = "") -> string { return Lang.get(key, replace, locale); }
    fn transChoice(key: string, count: long, replace: HashMap<string, any> = null, locale: string = "") -> string {
        return Lang.choice(key, count, replace, locale);
    }
}
